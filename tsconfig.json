{
  // Type-checking settings for the whole project. Vite bundles the app
  // (from Phase 2), so tsc only checks types and never writes files.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    // "Bundler" matches how Vite resolves imports.
    "moduleResolution": "Bundler",
    // A web app: browser (DOM) types are needed everywhere.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    // Strictness: catch as many mistakes as possible before the app runs.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,

    // Config files in the repo root are plain JavaScript; include them so
    // the project always has at least one input, but don't type-check them.
    "allowJs": true,
    "checkJs": false,

    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src", "tests", "*.config.ts", "*.config.js"]
}
