#!/bin/bash
# Git pre-commit hook: refuse commits that would publish personal data.
#
# Enabled per clone with:  git config core.hooksPath .githooks
#
# Checks every staged file (text and binary) for:
#   - home-folder paths (/Users/<name>, /home/<name>)
#   - email addresses (except GitHub noreply and the Claude co-author line)
#   - IPv4 addresses other than loopback / unspecified
#   - private terms listed in .git/info/personal-patterns (one regex per
#     line, e.g. your real name or computer name). That file lives inside
#     .git, so it is never committed or pushed.
# It also checks that the commit author email is a GitHub noreply address.

set -u

fail=0
report() {
  echo "pre-commit: $1" >&2
  fail=1
}

# 1. Author identity must not expose a real email address.
author_email=$(git config user.email || true)
case "$author_email" in
  *@users.noreply.github.com) ;;
  *) report "commit email '$author_email' is not a GitHub noreply address (git config user.email …@users.noreply.github.com)" ;;
esac

# 2. Content checks on staged files.
private_file="$(git rev-parse --git-dir)/info/personal-patterns"
private_regex=""
if [ -f "$private_file" ]; then
  # Join non-empty, non-comment lines into one alternation.
  private_regex=$(grep -vE '^\s*(#|$)' "$private_file" | paste -sd '|' -)
fi

path_regex='/(Users|home)/[A-Za-z0-9._-]+'
email_regex='[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
email_allowed='(@users\.noreply\.github\.com|noreply@anthropic\.com|@example\.(com|org)|support@accesslint\.com)'
ip_regex='(^|[^0-9.])([0-9]{1,3}\.){3}[0-9]{1,3}([^0-9.]|$)'
ip_allowed='(127\.0\.0\.1|0\.0\.0\.0)'

while IFS= read -r -d '' file; do
  case "$file" in
    package-lock.json | .claude/skills/*/guidelines.md) continue ;;
  esac
  content=$(git show ":$file" 2>/dev/null | LC_ALL=C tr -d '\000') || continue

  hits=$(printf '%s' "$content" | LC_ALL=C grep -aEo "$path_regex" | sort -u)
  [ -n "$hits" ] && report "$file contains a home-folder path: $(echo $hits)"

  hits=$(printf '%s' "$content" | LC_ALL=C grep -aEo "$email_regex" | LC_ALL=C grep -avE "$email_allowed" | sort -u)
  [ -n "$hits" ] && report "$file contains an email address: $(echo $hits)"

  hits=$(printf '%s' "$content" | LC_ALL=C grep -aEo "$ip_regex" | LC_ALL=C grep -aEo '([0-9]{1,3}\.){3}[0-9]{1,3}' | LC_ALL=C grep -avxE "$ip_allowed" | sort -u)
  [ -n "$hits" ] && report "$file contains an IP address: $(echo $hits)"

  if [ -n "$private_regex" ] && printf '%s' "$content" | LC_ALL=C grep -aqiE "$private_regex"; then
    report "$file contains a term from .git/info/personal-patterns"
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: commit blocked to keep personal data out of the repository." >&2
  exit 1
fi
exit 0
