{
  "$description": "ascend design tokens v0.3. Flat colours only, no gradients. Source of truth for the app's CSS variables.",
  "color": {
    "paper": "#F6F5F0",
    "surface": "#FBFAF7",
    "chrome": "#EFEDE6",
    "canvas": "#E7E5DD",
    "ink": "#151A1B",
    "graphite": "#5A6264",
    "disabled": "#B9B7AE",
    "rule": "#DEDCD3",
    "ruleSoft": "#EAE8E1",
    "mint": "#A8DCD2",
    "teal": "#1E5C5E",
    "warning": "#8A5A12",
    "danger": "#A33A35"
  },
  "contrast": {
    "$description": "WCAG ratios checked for the main pairs (AA needs 4.5:1 for body text).",
    "ink/paper": 16.09,
    "graphite/paper": 5.72,
    "teal/paper": 7.0,
    "ink/mint": 11.57
  },
  "theme": {
    "light": {
      "windowBackground": "{color.surface}",
      "tabStrip": "{color.chrome}",
      "tabActive": "{color.surface}",
      "border": "{color.rule}",
      "text": "{color.ink}",
      "textMuted": "{color.graphite}",
      "field": "#FFFFFF",
      "focusRing": "{color.teal}",
      "accent": "{color.teal}"
    },
    "dark": {
      "windowBackground": "#141818",
      "tabStrip": "#0F1212",
      "tabActive": "#1B2020",
      "border": "#2C3333",
      "text": "#ECEAE3",
      "textMuted": "#A3ABAB",
      "field": "#0F1212",
      "focusRing": "{color.mint}",
      "accent": "{color.mint}"
    }
  },
  "font": {
    "family": {
      "ui": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", sans-serif",
      "display": "\"Times New Roman\", Times, serif",
      "mono": "\"SF Mono\", ui-monospace, Menlo, monospace"
    },
    "size": { "caption": 12, "body": 13, "heading": 15, "title": 28, "display": 48 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "numeric": "tabular-nums"
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48 },
  "radius": { "field": 6, "button": 6, "window": 10 },
  "size": { "tabHeight": 44, "toolbarHeight": 44, "sidePanelRail": 48, "sidePanel": 264 },
  "texture": {
    "grain": {
      "$description": "Monochrome film grain, only on the app icon and mark. Never on UI text.",
      "amount": 16
    }
  }
}
