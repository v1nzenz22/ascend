{
  "$description": "ascend design tokens v0.4. Flat colours only, no gradients. Theme names match the FigCraft \"Theme\" variables. Source of truth for the app's CSS variables.",
  "color": {
    "paper": "#F6F5F0",
    "surface": "#FBFAF7",
    "chrome": "#EFEDE6",
    "canvas": "#E7E5DD",
    "ink": "#151A1B",
    "graphite": "#5A6264",
    "disabled": "#B9B7AE",
    "rule": "#DEDCD3",
    "ruleSoft": "#EAE8E1",
    "mint": "#A8DCD2",
    "teal": "#1E5C5E",
    "warning": "#8A5A12",
    "danger": "#A33A35"
  },
  "contrast": {
    "$description": "WCAG ratios checked for the main pairs (AA needs 4.5:1 for body text).",
    "ink/paper": 16.09,
    "graphite/paper": 5.72,
    "teal/paper": 7.0,
    "ink/mint": 11.57
  },
  "theme": {
    "light": {
      "bgApp": "{color.paper}",
      "bgSurface": "{color.surface}",
      "bgChrome": "{color.chrome}",
      "bgField": "#FFFFFF",
      "lineRule": "{color.rule}",
      "lineSoft": "{color.ruleSoft}",
      "textPrimary": "{color.ink}",
      "textMuted": "{color.graphite}",
      "textDisabled": "{color.disabled}",
      "textInverse": "{color.paper}",
      "accent": "{color.teal}",
      "accentOn": "{color.surface}",
      "accentSoft": "{color.mint}",
      "statusWarning": "{color.warning}",
      "statusDanger": "{color.danger}",
      "buttonPrimary": "{color.ink}",
      "buttonPrimaryPressed": "{color.graphite}",
      "focusRing": "{color.teal}"
    },
    "dark": {
      "bgApp": "#141818",
      "bgSurface": "#1B2020",
      "bgChrome": "#0F1212",
      "bgField": "#0F1212",
      "lineRule": "#2C3333",
      "lineSoft": "#2C3333",
      "textPrimary": "#ECEAE3",
      "textMuted": "#A3ABAB",
      "textDisabled": "{color.graphite}",
      "textInverse": "#141818",
      "accent": "{color.mint}",
      "accentOn": "{color.ink}",
      "accentSoft": "{color.teal}",
      "statusWarning": "#ECEAE3",
      "statusDanger": "#E8837C",
      "buttonPrimary": "#ECEAE3",
      "buttonPrimaryPressed": "#A3ABAB",
      "focusRing": "{color.mint}"
    }
  },
  "font": {
    "family": {
      "ui": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", sans-serif",
      "display": "\"Times New Roman\", Times, serif",
      "mono": "\"SF Mono\", ui-monospace, Menlo, monospace"
    },
    "size": {
      "caption": 12,
      "body": 13,
      "heading": 15,
      "title": 28,
      "display": 48,
      "mobileBody": 15,
      "mobileLabel": 13,
      "mono": 12,
      "input": 16,
      "numberLarge": 32,
      "numberMedium": 20
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "numeric": "tabular-nums",
    "styles": {
      "Display": {
        "family": "display",
        "size": 48,
        "weight": "regular"
      },
      "Title": {
        "family": "display",
        "size": 28,
        "weight": "regular"
      },
      "Heading": {
        "family": "ui",
        "size": 15,
        "weight": "semibold"
      },
      "Mobile/Body": {
        "family": "ui",
        "size": 15,
        "weight": "regular"
      },
      "Mobile/Label": {
        "family": "ui",
        "size": 13,
        "weight": "medium"
      },
      "Body": {
        "family": "ui",
        "size": 13,
        "weight": "regular"
      },
      "Caption": {
        "family": "ui",
        "size": 12,
        "weight": "regular"
      },
      "Mono": {
        "family": "mono",
        "size": 12,
        "weight": "regular"
      },
      "Number/Large": {
        "family": "ui",
        "size": 32,
        "weight": "medium"
      },
      "Number/Medium": {
        "family": "ui",
        "size": 20,
        "weight": "medium"
      },
      "Input": {
        "family": "ui",
        "size": 16,
        "weight": "regular",
        "note": "16 px minimum so iOS does not zoom into focused fields"
      }
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48
  },
  "radius": {
    "field": 6,
    "button": 6,
    "window": 10
  },
  "size": {
    "fieldHeight": 44,
    "buttonHeight": 44,
    "chipHeight": 36,
    "iconSize": 24,
    "sideNav": 264
  },
  "texture": {
    "grain": {
      "$description": "Monochrome film grain, only on the app icon and mark. Never on UI text.",
      "amount": 16
    }
  },
  "$notes": {
    "darkStatus": "In dark mode warning uses the text colour and danger uses the lighter red #E8837C (the base colours fall below 4.5:1 on #141818; #E8837C reaches 6.8:1), so states like 'über Ziel' must be shown in words, not by colour alone."
  }
}
