{
  "$description": "ascend design tokens. Source of truth for colors, type and spacing; src/renderer CSS variables are generated from or kept in sync with this file.",
  "color": {
    "mint": {
      "50": "#EAFBF5",
      "100": "#C9F5E6",
      "200": "#A3EED6",
      "300": "#74E3C2",
      "400": "#48D3AE",
      "500": "#22BC98",
      "600": "#16977C",
      "700": "#127862"
    },
    "blue": {
      "50": "#EAF4FD",
      "100": "#CDE5FA",
      "200": "#9DCBF5",
      "300": "#66ABEE",
      "400": "#3A8EE6",
      "500": "#2275D6",
      "600": "#1A5DB2",
      "700": "#16498A"
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F5F8F9",
      "100": "#E9EFF1",
      "200": "#D5DFE3",
      "400": "#93A4AD",
      "600": "#56676F",
      "800": "#25333A",
      "900": "#141E24",
      "950": "#0C1418"
    },
    "semantic": {
      "accent": "{color.mint.500}",
      "accentStrong": "{color.blue.500}",
      "secure": "{color.mint.600}",
      "warning": "#E8A13A",
      "danger": "#E0565B"
    },
    "gradient": {
      "brand": "linear-gradient(135deg, #74E3C2 0%, #2BB4C8 50%, #2275D6 100%)"
    }
  },
  "theme": {
    "light": {
      "windowBackground": "{color.neutral.50}",
      "chromeBackground": "{color.neutral.0}",
      "tabActive": "{color.neutral.0}",
      "tabInactive": "{color.neutral.100}",
      "border": "{color.neutral.200}",
      "text": "{color.neutral.900}",
      "textMuted": "{color.neutral.600}",
      "addressBar": "{color.neutral.50}",
      "focusRing": "{color.mint.400}"
    },
    "dark": {
      "windowBackground": "{color.neutral.950}",
      "chromeBackground": "{color.neutral.900}",
      "tabActive": "{color.neutral.800}",
      "tabInactive": "{color.neutral.900}",
      "border": "#2E3D44",
      "text": "#E8F0F2",
      "textMuted": "{color.neutral.400}",
      "addressBar": "{color.neutral.950}",
      "focusRing": "{color.mint.300}"
    }
  },
  "font": {
    "family": {
      "ui": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", sans-serif",
      "mono": "\"SF Mono\", ui-monospace, Menlo, monospace"
    },
    "size": { "xs": 11, "sm": 12, "md": 13, "lg": 15, "xl": 20, "xxl": 28 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32 },
  "radius": { "sm": 6, "md": 8, "lg": 12, "pill": 999 },
  "size": { "tabHeight": 34, "toolbarHeight": 44, "sidePanelRail": 48 }
}
